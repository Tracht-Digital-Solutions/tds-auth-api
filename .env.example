APP_ENV=production

# MariaDB on the production host
DB_HOST=
DB_PORT=3306
DB_NAME=tds_auth
DB_USER=
DB_PASS=

# Service-to-service token. Gates the internal onboarding endpoint
# (POST /admin/customer-credentials) that tds-customer-api calls. This is NOT
# a user login — per-admin login now goes through email/password + JWT.
# Falls back to ADMIN_TOKEN when unset, so existing deployments keep working.
SERVICE_TOKEN=

# Legacy shared admin token. No longer powers a UI login (replaced by
# per-admin app_user credentials + JWT). Kept only as the SERVICE_TOKEN
# fallback above during the transition — remove once SERVICE_TOKEN is set.
ADMIN_TOKEN=

# Bootstrap admin. Two ways to create the first admin:
#  1. The seed migration (20260701000002) auto-creates ONE admin on first
#     `composer migrate` IF none exists yet, reading the two vars below.
#     Defaults to admin@tracht-digital.de / tds-setup-admin when unset — set
#     these BEFORE the first migrate to avoid the public default ever existing.
#  2. `composer create-admin -- you@example.com [password]` reads the same
#     vars as fallbacks for its arguments.
# Either way the account is flagged must-change-password: the first login is
# forced through the change-password screen before the panel opens.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# JWT — generate with `composer keygen` (writes keys/private.pem +
# keys/public.pem). Put the PRIVATE key contents here as a single line
# (replace newlines with \n). Public key stays in the repo at keys/public.pem
# and is also served via /.well-known/jwks.json so other services can verify.
JWT_PRIVATE_KEY=
JWT_KEY_ID=tds-auth-2026-1
JWT_ISSUER=https://api.tracht-digital.de/auth
JWT_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# Cookie config (both panels use the cross-subdomain httpOnly session cookie)
COOKIE_DOMAIN=.tracht-digital.de
COOKIE_NAME=tds_session

# "Angemeldet bleiben" (30 days). A SECOND httpOnly cookie holding a rotating
# remember-me token; POST /refresh trades it for a fresh short-lived JWT. The
# session JWT deliberately stays at JWT_TTL_SECONDS — other services verify it
# against the JWKS and never call us, so a long JWT would be a long
# NON-REVOCABLE credential. Defaults to JWT_REFRESH_TTL_SECONDS when unset.
REMEMBER_COOKIE_NAME=tds_remember
REMEMBER_TTL_SECONDS=2592000

# Passkeys (WebAuthn). WEBAUTHN_RP_ID must be the REGISTRABLE DOMAIN, not the
# login host: an origin satisfies an RP ID when the RP ID is a registrable-domain
# suffix of it, so `tracht-digital.de` makes one passkey work on auth. /
# management. / app. / tools. Setting it to auth.tracht-digital.de would silently
# produce passkeys usable only there.
# WEBAUTHN_CHALLENGE_SECRET signs the short-lived challenge cookie (this API has
# no session). Optional — falls back to a hash of the JWT private key. The
# challenge is not a secret; the signature only stops a client choosing its own.
WEBAUTHN_RP_ID=tracht-digital.de
WEBAUTHN_RP_NAME=Tracht Digital Solutions
WEBAUTHN_COOKIE_NAME=tds_wa_challenge
WEBAUTHN_CHALLENGE_SECRET=

# Login rate limit — sliding window per (route, IP). 10 attempts per
# 15 min is generous for legitimate users while still rate-limiting
# brute-force / credential-stuffing runs.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900

# CORS — comma-separated origin list. Must include the central login site
# (auth.tracht-digital.de): it POSTs /login and reads /me cross-origin with
# credentials, and responses echo an exact origin (never *) so an unlisted
# origin is blocked by the browser.
CORS_ALLOWED_ORIGINS=https://tracht-digital.de,https://blog.tracht-digital.de,https://auth.tracht-digital.de,https://management.tracht-digital.de,https://app.tracht-digital.de,https://tools.tracht-digital.de,http://localhost:4321
