APP_ENV=production

# MariaDB on netcup
DB_HOST=
DB_PORT=3306
DB_NAME=tds_auth
DB_USER=
DB_PASS=

# Phase 2-bridging admin token. Phase 4+ this is replaced by per-admin
# customer_credential rows. Until then, ADMIN_TOKEN is the single shared
# secret for the /admin/login endpoint.
ADMIN_TOKEN=

# JWT — generate with `composer keygen` (writes keys/private.pem +
# keys/public.pem). Put the PRIVATE key contents here as a single line
# (replace newlines with \n). Public key stays in the repo at keys/public.pem
# and is also served via /.well-known/jwks.json so other services can verify.
JWT_PRIVATE_KEY=
JWT_KEY_ID=tds-auth-2026-1
JWT_ISSUER=https://api.tracht-digital.de/auth
JWT_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# Cookie config (admin panel uses cookie auth; customer panel uses Bearer)
COOKIE_DOMAIN=.tracht-digital.de
COOKIE_NAME=tds_session

# Login rate limit — sliding window per (route, IP). 10 attempts per
# 15 min is generous for legitimate users while still rate-limiting
# brute-force / credential-stuffing runs.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900

# CORS — comma-separated origin list
CORS_ALLOWED_ORIGINS=https://tracht-digital.de,https://blog.tracht-digital.de,https://admin.tracht-digital.de,https://app.tracht-digital.de,http://localhost:4321
